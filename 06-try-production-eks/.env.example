# ==============================================================================
# Environment Configuration for hello-k8s Full Stack (Template)
# Copy to .env and adjust as necessary
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# API Backend Configuration (Port 9000)
API_PORT=9000
PORT=9000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shop
DB_USER=shop
DB_PASSWORD=your_secure_password
DB_SSL=false
JWT_SECRET=your_jwt_secret_key_here
DATABASE_URL=postgres://shop:your_secure_password@postgres:5432/shop

# Frontend Storefront (shop-app) (Port 9001)
SHOP_PORT=9001

# Frontend Dashboard (shop-dashboard) (Port 9002)
DASHBOARD_PORT=9002

# API Base URL for Frontend Applications
VITE_API_URL=http://localhost:9000

# Google OAuth 2.0 Web Client ID & Secret (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
